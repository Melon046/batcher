# ===========================================================================
# BATCHER — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored. NEVER commit real keys.
#
# IMPORTANT: Batcher is a SEPARATE project from Wade. Use a separate Supabase
# project and separate API keys — do not reuse Wade's .env.local here, or the
# two apps will write to the same database.
# ===========================================================================

# --- Supabase (use a DIFFERENT project from Wade) --------------------------
# Dashboard -> Project Settings -> API
# Paste the PUBLIC (publishable / anon) key here, never the secret one.
NEXT_PUBLIC_SUPABASE_URL=https://your-batcher-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-batcher-anon-key

# --- LLM providers ---------------------------------------------------------
# PRIMARY — Google AI Studio (free tier, no credit card required)
# Get a key: https://aistudio.google.com/apikey
# This ONE key also powers embeddings (memory + documents). No second key.
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key

# FALLBACK — Groq (free tier, much larger daily request budget)
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-key

# --- Model selection (optional — defaults live in src/lib/models.ts) -------
# Model IDs get retired. If you see a 404 "model not found", override here.
BATCHER_PRIMARY_MODEL=gemini-2.5-flash
BATCHER_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- App -------------------------------------------------------------------
# 3001, not 3000 — Wade uses 3000, so both can run at once.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Guardrails ------------------------------------------------------------
# Max output tokens per batch item. Batcher answers several questions per
# request, so this multiplies: 4 items x 700 tokens = 2,800 tokens per send.
BATCHER_MAX_OUTPUT_TOKENS=700

# Hard ceiling on how many questions one batch may contain. Defaults to 8.
BATCHER_MAX_BATCH_SIZE=8

# Max tokens one user may spend per day. 0 disables the check.
# Defaults to 0 (off) — turn it on before you share the join code widely.
BATCHER_DAILY_TOKEN_LIMIT=0

# ===========================================================================
# MEMORY + DOCUMENTS (stage 1 of the growth path)
# ---------------------------------------------------------------------------
# Everything below has a working default. You only need to touch it if you
# want to change how much Batcher reads, or how much it costs.
# Embeddings reuse GOOGLE_GENERATIVE_AI_API_KEY above — no extra key needed.
# ===========================================================================

# Chunking. 1200 chars (~300 tokens) per passage, 150 chars of overlap so a
# sentence that straddles a boundary is still retrievable from one side.
BATCHER_CHUNK_SIZE=1200
BATCHER_CHUNK_OVERLAP=150

# How many document passages to pull into each batch. This is the main cost
# dial: every passage is re-sent inside EVERY item's prompt.
# 0 disables document retrieval entirely.
BATCHER_RETRIEVAL_CHUNKS=4

# How many remembered facts to pull in per batch. 0 disables it.
BATCHER_RETRIEVAL_MEMORIES=3

# Minimum cosine similarity (0-1) for a passage to count as relevant.
# Lower = more context, more tokens. Higher = tighter, may miss things.
BATCHER_RETRIEVAL_MIN_SCORE=0.35

# 'off' stores documents without embeddings; Batcher then searches them by
# keyword instead. Useful if you are troubleshooting a quota problem.
BATCHER_EMBEDDINGS=on

# Embedding model. Must produce 768 dimensions to match the vector(768)
# columns in 0002_memory_documents.sql.
BATCHER_EMBEDDING_MODEL=gemini-embedding-001

# Largest upload accepted, in MB. Supabase free storage is 1 GB total.
BATCHER_MAX_UPLOAD_MB=8
